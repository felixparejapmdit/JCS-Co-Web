# Cloud AOS environment (copy to .env and fill in; never commit .env).
#
# Leave DATABASE_HOST empty to run the preview on sample data. Set it to connect to
# MySQL: a restored test copy first, the client's server only after the parity tests.

# --- Client MySQL server (PLAN.md section 4.6.2) ---
DATABASE_HOST=
DATABASE_PORT=3306
# A least-privilege account created with the client's DBA; never root.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_POOL_SIZE=5
# Requests that may wait for a free connection; beyond it the server answers "busy" at once.
DATABASE_QUEUE_LIMIT=200
# Longest a single statement may run, in milliseconds; the request then fails with a clear 504.
DATABASE_QUERY_TIMEOUT_MS=30000
# Saving is refused until this is true. Keep it false on the live server until the
# module has passed its parity tests (PLAN.md section 8.3).
DATABASE_ALLOW_WRITES=false

# Where the app reads its data until an administrator chooses in Administration > Data Source:
# memory (sample data in MemoryStore) or mysql (the databases below). Default: mysql when
# DATABASE_HOST is set. The choice made on that page is kept in .cloudaos/settings.json.
DATA_SOURCE=
# Lets Administration > Data Source empty the active company databases and load the sample data.
# Refused unless DATABASE_HOST is this computer (localhost). Never set it for a company server.
DATABASE_ALLOW_SAMPLE_LOAD=false
# Optional session SQL mode, e.g. NO_ENGINE_SUBSTITUTION for the local schema rebuilt from code
# (database/schema_from_code.sql), whose column types are inferred. Leave empty for a real server.
DATABASE_SQL_MODE=

# Companies switched off (comma list of business areas), used until an administrator decides in
# Administration > Companies (kept in .cloudaos/settings.json). When unset, the default switches off
# 8100 JCS Chemical (on hold) and 8200 APF Corporation (dissolved): only Chemag Trading is active.
# Example: COMPANIES_DISABLED=8200 keeps JCS on; an empty value turns every company on.
# COMPANIES_DISABLED=

# --- Platform (docs/ARCHITECTURE.md) ---
# Redis for the read cache, rate limits, idempotency and background jobs, shared by every instance.
# Empty: this server's memory (fine for one server). Example: redis://:password@redis:6379/0
REDIS_URL=
# Read cache: on by default against MySQL. false switches it off, true forces it on.
CACHE_READS=
# Longest life of a cached read, in seconds. Bounds how long a change made outside Cloud AOS
# (the legacy AOS100 on the same database) can take to show.
CACHE_TTL_SECONDS=15
# API request log: errors and slow requests by default; all logs every request (JSON lines).
LOG_REQUESTS=
LOG_SLOW_MS=1000
# Web origins allowed to call the public API (/api/v1) from a browser, comma separated.
API_CORS_ORIGINS=
# Largest request body the API accepts, in MB (logos and Excel lists fit in the default).
API_MAX_BODY_MB=5
# Most documents one list answer carries (newest first); search and dates reach older ones.
LIST_LIMIT=2000

# Database names per company (legacy defaults)
DB_JCS=jcs
DB_APF=apf
DB_CHEMAG=chemag
DB_BFI=bfi
DB_BFI_ADMIN=bfi_admin

# --- Sign-in sessions ---
# Required when DATABASE_HOST is set. Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# The session cookie is marked Secure automatically on HTTPS. Set true to force it when a
# TLS proxy in front of Cloud AOS does not send X-Forwarded-Proto.
COOKIE_SECURE=false

# --- Development MySQL container only (docker compose --profile mysql) ---
MYSQL_ROOT_PASSWORD=
