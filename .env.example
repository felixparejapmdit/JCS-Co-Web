# Environment Configuration for AOS100 NextGen
NODE_ENV=development
PORT=8180

# Database (PostgreSQL 16)
POSTGRES_USER=aos_admin
POSTGRES_PASSWORD=Aos100SecurePass!
POSTGRES_DB=aos100_core
DATABASE_URL=postgresql://aos_admin:Aos100SecurePass!@localhost:5432/aos100_core?sslmode=disable

# Cache & Lock (Redis 7)
REDIS_PASSWORD=RedisSecurePass!
REDIS_URL=redis://:RedisSecurePass!@localhost:6379

# Security & Authentication
JWT_SECRET=SuperSecretKeyForAOS100NextGenJwtAuth2026!
JWT_EXPIRES_IN=8h

# Default Multi-Tenant BA (8100: JCS, 8200: APF, 8300: Chemag)
DEFAULT_TENANT_ID=8100
