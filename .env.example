# Cloud AOS environment (copy to .env and fill in; never commit .env).
#
# Leave DATABASE_HOST empty to run the preview on sample data. Set it to connect to
# MySQL: a restored test copy first, the client's server only after the parity tests.

# --- Client MySQL server (PLAN.md section 4.6.2) ---
DATABASE_HOST=
DATABASE_PORT=3306
# A least-privilege account created with the client's DBA; never root.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_POOL_SIZE=5
# Saving is refused until this is true. Keep it false on the live server until the
# module has passed its parity tests (PLAN.md section 8.3).
DATABASE_ALLOW_WRITES=false

# Database names per company (legacy defaults)
DB_JCS=jcs
DB_APF=apf
DB_CHEMAG=chemag
DB_BFI=bfi
DB_BFI_ADMIN=bfi_admin

# --- Sign-in sessions ---
# Required when DATABASE_HOST is set. Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# The session cookie is marked Secure automatically on HTTPS. Set true to force it when a
# TLS proxy in front of Cloud AOS does not send X-Forwarded-Proto.
COOKIE_SECURE=false

# --- Development MySQL container only (docker compose --profile mysql) ---
MYSQL_ROOT_PASSWORD=
